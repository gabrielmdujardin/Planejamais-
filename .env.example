# =============================================================================
# PLANEJA+ — CONFIGURAÇÃO DE AMBIENTE (INFRAESTRUTURA PRÓPRIA POSTGRESQL LOCAL)
# Copie este arquivo para .env: Copy-Item .env.example .env
# =============================================================================

# 1. Banco de Dados PostgreSQL Local (planeja_plus)
DB_PROVIDER=postgresql
POSTGRES_USER=planeja
POSTGRES_PASSWORD=planeja_local_2026
POSTGRES_DB=planeja_plus
POSTGRES_PORT=5432
DATABASE_URL=postgresql://planeja:planeja_local_2026@127.0.0.1:5432/planeja_plus

# 2. Autenticação Própria (Hash Scrypt/Argon2id + Sessões JWT HMAC-SHA256)
AUTH_SECRET=planeja-plus-local-jwt-hmac-secret-2026-tcc-key
STRICT_AUTH_ONLY=false

# 3. Serviço de E-mail Transacional (Mailpit em Dev / SMTP Real em Produção)
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
MAIL_FROM="Planeja+ <nao-responda@planeja.local>"
MAILPIT_SMTP_PORT=1025
MAILPIT_WEB_PORT=8025

# 4. Armazenamento Persistente de Arquivos (Substituto Local do Supabase Storage)
STORAGE_DIR=./storage/uploads

# 5. Aplicação e Rotinas Agendadas (Cron)
APP_PORT=3000
APP_BIND_HOST=0.0.0.0
APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
CRON_SECRET=planeja-cron-secret-local-2026
JOBS_SECRET_TOKEN=planeja-cron-secret-local-2026

# 6. pgAdmin 4 (Opcional — perfil Docker "pgadmin")
PGADMIN_PORT=5050
PGADMIN_EMAIL=admin@planeja.local
PGADMIN_PASSWORD=planeja_admin_2026
